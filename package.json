{
  "name": "nexus-launcher",
  "version": "1.0.0",
  "description": "Launcher giochi stile Steam / Xbox",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nexus.launcher",
    "productName": "Nexus Launcher",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "src/**/*"],
    "win": { "target": "portable" }
  }
}
